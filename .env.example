# Copy to .env and fill in. Never commit .env. Every key is optional: a missing key makes that tool
# report AUTH_REQUIRED (or NOT_TESTED) and the rest of Satyapan keeps working.
# On Cloud Run the secrets below come from Secret Manager (deploy/deploy_api.sh), not from a file.
SATYAPAN_CONTACT=your-team-email

# --- Google: Fact Check Tools + Safe Browsing (restrict the key to those two APIs) [secret]
GOOGLE_API_KEY=

# --- AI models (hosted only, no local models). Chat and embeddings are configured independently.
# AI_CHAT_PROVIDER / AI_EMBEDDING_PROVIDER: cloudflare | openai | huggingface | none
# Left empty: Cloudflare when its two values below are set, otherwise openai, otherwise huggingface.
AI_CHAT_PROVIDER=
AI_EMBEDDING_PROVIDER=

# Option A, FREE (default): Cloudflare Workers AI on the Workers Free plan [CLOUDFLARE_API_TOKEN is secret]
# 10,000 neurons a day, reset at 00:00 UTC. When used up, calls fail with error 3036 and Satyapan pauses
# AI calls until 00:00 UTC. Nothing is charged on the Free plan. Do not upgrade to Workers Paid unless you
# want paid usage.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Empty = defaults: chat @cf/qwen/qwen3-30b-a3b-fp8, fallback @cf/meta/llama-4-scout-17b-16e-instruct,
# embeddings @cf/baai/bge-m3
CLOUDFLARE_CHAT_MODEL=
CLOUDFLARE_CHAT_FALLBACK_MODEL=
CLOUDFLARE_EMBEDDING_MODEL=

# Option B: any other hosted OpenAI-compatible provider (set AI_CHAT_PROVIDER=openai and/or
# AI_EMBEDDING_PROVIDER=openai) [LLM_API_KEY, EMBEDDING_API_KEY are secret]
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional chat fallback on ANOTHER provider, used when the first is rate limited or down (works with any option).
# Example with a free Groq key: LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1  LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Option C, PAID: Hugging Face Inference Providers (AI_CHAT_PROVIDER=huggingface) [HF_TOKEN is secret]
# Fine-grained token with only the "Inference Providers" permission.
# Free HF accounts have no included credits: buy credits or use PRO before calling the API.
HF_TOKEN=
# Pin the provider with a suffix so the router does not pick an expensive one.
HF_CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507:deepinfra
# Fallback on a DIFFERENT provider, used when the primary fails
HF_CHAT_FALLBACK_MODEL=openai/gpt-oss-120b:groq
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
HF_EMBEDDING_PROVIDER=hf-inference
HF_EMBEDDING_FALLBACK_PROVIDER=deepinfra
# Call caps per instance per day (Cloudflare also enforces its own free daily allocation)
SATYAPAN_DAILY_LLM_CALLS=600
SATYAPAN_DAILY_EMBEDDING_CALLS=3000

# --- MongoDB Atlas [MONGODB_URI is secret]. Unset = local JSON files in data/
MONGODB_URI=
MONGODB_DB=satyapan
# Records (they contain the user's text) are deleted automatically after this many hours
SATYAPAN_RETENTION_HOURS=168

# --- Web app and deployment
# Comma-separated origins allowed to call the API from a browser
SATYAPAN_ALLOWED_ORIGINS=http://localhost:3000
# 0 locally. 1 on Cloud Run: the client IP is the last X-Forwarded-For entry
SATYAPAN_TRUSTED_PROXY_HOPS=0

# --- Optional services
GOOGLE_VISION_API_KEY=
VISION_USE_GCLOUD=
GOOGLE_CLOUD_PROJECT=
URLSCAN_API_KEY=
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
VIRUSTOTAL_API_KEY=

# Set to 1 ONLY after eval/detector_eval.py says may_enter_verdicts: true
AI_IMAGE_DETECTOR_CALIBRATED=
AUDIO_DETECTOR_MODEL=
AUDIO_DETECTOR_CALIBRATED=

SATYAPAN_RETRIES=
SATYAPAN_TIMEOUT_S=
SATYAPAN_LLM_TIMEOUT_S=
SATYAPAN_RATE_LIMIT_PER_MINUTE=
SATYAPAN_MAX_VIDEO_MB=
TESSERACT_LANGS=
